# Set only to the approved public HTTPS origin; do not invent a Mood domain.
VITE_SITE_URL=
# Keep false in previews and until public content is approved. Rebuild after changes.
VITE_ALLOW_INDEXING=false

# Browser-safe Supabase credentials. Keep server-side secrets outside VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
